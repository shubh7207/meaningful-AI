# FEATURE 1 LOGIC: Speech-to-Text Pipeline
    def start_voice_dictation(self):
        """Prepares UI state and spins off an isolated hardware recording thread."""
        self.status_label.configure(text="Listening closely to your voice... speak now.")
        threading.Thread(target=self.listen_voice_thread, daemon=True).start()

    def listen_voice_thread(self):
        """Captures local microphone inputs and passes translation directly into text box."""
        r = sr.Recognizer()
        with sr.Microphone() as source:
            r.adjust_for_ambient_noise(source, duration=0.6)
            try:
                audio = r.listen(source, timeout=5, phrase_time_limit=12)
                text = r.recognize_google(audio)
                self.after(0, lambda: self.entry_box.insert("end", f" {text}"))
                self.after(0, lambda: self.status_label.configure(text="Voice added successfully."))
            except sr.WaitTimeoutError:
                self.after(0, lambda: self.status_label.configure(text="Silence detected. Tap mic to try again."))
            except Exception:
                self.after(0, lambda: self.status_label.configure(text="Couldn't process audio stream clearly."))

    # FEATURE 2 LOGIC: System Metric Loop
    def update_hardware_stats(self):
        """Asynchronously updates local processing stats every two seconds."""
        cpu = psutil.cpu_percent()
        ram = psutil.virtual_memory().percent
        self.hardware_label.configure(text=f"System Load -> CPU: {cpu}%  |  RAM: {ram}%")
        self.after(2000, self.update_hardware_stats)

    # FEATURE 3 LOGIC: Incognito Control
    def toggle_incognito(self):
        """Switches global states and adapts visual color language to indicate privacy level."""
        global IS_INCOGNITO
        IS_INCOGNITO = self.incognito_switch.get() == 1
        if IS_INCOGNITO:
            self.configure(fg_color="#1F151A") # Alters background to a deep privacy ash wine
            self.status_label.configure(text="Shredder mode enabled. Everything typed here disappears on exit.")
        else:
            self.configure(fg_color=BG_COLOR)
            self.status_label.configure(text="")

    # FEATURE 4 LOGIC: Background Application Hiding
    def toggle_window_visibility(self):
        """Brings the interface smoothly into focus or hides it into background runtime via hotkey."""
        if self.state() == "normal":
            self.withdraw()
        else:
            self.deiconify()
            self.focus_force()
